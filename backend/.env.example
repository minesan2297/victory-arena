# Victory Arena v2.0 - Configuration Template
# Sao chep file nay thanh .env de cau hinh bien moi truong

# App
APP_NAME="Hệ thống Quản lý Sân Bóng Mini Victory Tích Hợp AI"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (Mac dinh luu tai backend/data/mini_victory.db)
DATABASE_URL=sqlite:///./data/mini_victory.db

# JWT Auth & Security
JWT_SECRET_KEY=footy-arena-secret-key-nhom20-2026
JWT_EXPIRY_MINUTES=60

# Lock Expiry (Thoi gian khoa giu cho tam thoi khi chua dat coc: 10 phut)
LOCK_EXPIRY_MINUTES=10

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
